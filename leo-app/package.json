{
  "name": "leo-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "out/main/main.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "build": "electron-vite build",
    "build:web": "tsc -b && vite build",
    "dist": "electron-vite build && electron-builder --win",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.leo.ledger",
    "productName": "leo记账",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/sql.js/dist/*"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "leo-${version}-setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "leo记账"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.75.0",
    "typescript": "~5.7.2",
    "vite": "^7.0.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
